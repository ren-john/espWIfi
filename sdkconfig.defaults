# Maximize CPU frequency to 240MHz (default in new IDF projects is 160MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Maximize PSRAM Speed to 80MHz and enable Octal PSRAM (Required for ESP32-S3 camera buffer)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Use the bounce-buffer path with DRAM frame buffers while investigating
# malformed JPEGs and the stream task InstructionFetchError.
# CONFIG_CAMERA_PSRAM_DMA is not set

# Optimize WiFi for high throughput streaming
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
# CONFIG_HEAP_POISONING_DISABLED is not set
CONFIG_HEAP_POISONING_LIGHT=y
# CONFIG_COMPILER_STACK_CHECK_MODE_NONE is not set
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# Disable brownout detection for the requested power diagnostic.
# CONFIG_ESP_BROWNOUT_DET is not set
